  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F7695",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A8D8B9"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F0B47A"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E28EB4"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8ED4E6"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B6A5FF"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "variable.other.property",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E8D7C0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E28EB4"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8ED4E6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFF1F4",
        "background": "#8B334B"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#B6A5FF",
    "enum": "#B6A5FF",
    "interface": "#B6A5FF",
    "struct": "#B6A5FF",
    "type": "#B6A5FF",
    "typeParameter": "#C7B8FF",
    "function": "#8ED4E6",
    "method": "#8ED4E6",
    "parameter": "#E8D7C0",
    "property": "#DDBFD3",
    "variable": "#E8E6F0",
    "enumMember": "#F0B47A",
    "namespace": "#B6A5FF",
    "decorator": "#F3A7C7"
  }
}
