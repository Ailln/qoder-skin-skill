  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E68A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8FE0B4"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F7A854"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFC93C"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#A99DFF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B6A5FF"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "variable.other.property",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F0DDBB"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FFC93C"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A99DFF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFF0F3",
        "background": "#8B334B"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#B6A5FF",
    "enum": "#B6A5FF",
    "interface": "#B6A5FF",
    "struct": "#B6A5FF",
    "type": "#B6A5FF",
    "typeParameter": "#C9BCFF",
    "function": "#A99DFF",
    "method": "#A99DFF",
    "parameter": "#F0DDBB",
    "property": "#D9C6F5",
    "variable": "#EAE8FA",
    "enumMember": "#F7A854",
    "namespace": "#B6A5FF",
    "decorator": "#FFD65C"
  }
}
